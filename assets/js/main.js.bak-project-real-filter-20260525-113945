/* ---------- AS GREETING COVER ---------- */
(function () {
  function runGreetingCover() {
    var cover = document.getElementById('asGreetingCover');
    if (!cover) return;

    document.documentElement.classList.add('as-greeting-lock');

    window.setTimeout(function () {
      cover.classList.add('is-leaving');
      document.documentElement.classList.remove('as-greeting-lock');

      window.setTimeout(function () {
        if (cover && cover.parentNode) {
          cover.parentNode.removeChild(cover);
        }
      }, 900);
    }, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runGreetingCover, { once: true });
  } else {
    runGreetingCover();
  }
})();
 /* ---------- END AS GREETING COVER ---------- */


/* ---------- AS PROJECT FILTERS FINAL ---------- */
(function () {
  function normalizeText(text) {
    return String(text || '')
      .toLowerCase()
      .replace(/\s+/g, ' ')
      .trim();
  }

  function getFilterFromText(text) {
    var value = normalizeText(text);

    if (value.includes('все')) return 'all';
    if (value.includes('дом')) return 'houses';
    if (value.includes('квартир')) return 'apartments';
    if (value.includes('коммер')) return 'commercial';
    if (value.includes('процесс')) return 'process';

    return 'all';
  }

  function getCardCategory(card) {
    if (card.dataset.projectCategory) return card.dataset.projectCategory;
    if (card.dataset.category) return card.dataset.category;
    if (card.dataset.filter) return card.dataset.filter;

    var text = normalizeText(card.textContent);

    if (
      text.includes('дом') ||
      text.includes('таунхаус') ||
      text.includes('коттедж') ||
      text.includes('загород')
    ) {
      return 'houses';
    }

    if (
      text.includes('квартир') ||
      text.includes('апартамент')
    ) {
      return 'apartments';
    }

    if (
      text.includes('офис') ||
      text.includes('коммер') ||
      text.includes('ресторан') ||
      text.includes('салон') ||
      text.includes('шоурум')
    ) {
      return 'commercial';
    }

    if (
      text.includes('в процессе') ||
      text.includes('строится') ||
      text.includes('реализации') ||
      text.includes('разработка')
    ) {
      return 'process';
    }

    return 'all';
  }

  function initProjectFilters() {
    var pageText = normalizeText(document.body.textContent);
    var isProjectsPage =
      window.location.pathname.replace(/\/+$/, '') === '/projects' ||
      pageText.includes('все проекты') ||
      pageText.includes('частные дома') ||
      pageText.includes('коммерческие');

    if (!isProjectsPage) return;

    var buttons = Array.from(document.querySelectorAll(
      '.projects-filter button, .projects-filters button, .project-filters button, .filters button, .filter-btn, [data-project-filter], [data-filter]'
    ));

    if (!buttons.length) {
      buttons = Array.from(document.querySelectorAll('button, a')).filter(function (el) {
        var text = normalizeText(el.textContent);
        return (
          text === 'все проекты' ||
          text === 'частные дома' ||
          text === 'квартиры' ||
          text === 'коммерческие' ||
          text === 'в процессе'
        );
      });
    }

    var cards = Array.from(document.querySelectorAll(
      '[data-project-card], .project-card, .projects-card, .projects-item, .project-item, .as-project-card'
    ));

    cards = cards.filter(function (card) {
      return !buttons.includes(card);
    });

    if (!buttons.length || !cards.length) return;

    buttons.forEach(function (button) {
      if (!button.dataset.projectFilter) {
        button.dataset.projectFilter = button.dataset.filter || getFilterFromText(button.textContent);
      }

      button.setAttribute('type', button.tagName.toLowerCase() === 'button' ? 'button' : button.getAttribute('type') || '');
    });

    cards.forEach(function (card) {
      if (!card.dataset.projectCategory) {
        card.dataset.projectCategory = getCardCategory(card);
      }
    });

    function setActiveButton(activeButton) {
      buttons.forEach(function (button) {
        button.classList.remove('active', 'is-active');
        button.setAttribute('aria-pressed', 'false');
      });

      activeButton.classList.add('active', 'is-active');
      activeButton.setAttribute('aria-pressed', 'true');
    }

    function filterProjects(filter) {
      cards.forEach(function (card) {
        var category = card.dataset.projectCategory || 'all';
        var show = filter === 'all' || category === filter;

        card.classList.toggle('project-card-hidden', !show);
        card.hidden = !show;
      });
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();

        var filter = button.dataset.projectFilter || getFilterFromText(button.textContent);

        setActiveButton(button);
        filterProjects(filter);

        if (window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('filter', filter);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    var params = new URLSearchParams(window.location.search);
    var startFilter = params.get('filter') || 'all';

    var startButton = buttons.find(function (button) {
      return button.dataset.projectFilter === startFilter;
    }) || buttons[0];

    setActiveButton(startButton);
    filterProjects(startButton.dataset.projectFilter || 'all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters, { once: true });
  } else {
    initProjectFilters();
  }
})();
 /* ---------- END AS PROJECT FILTERS FINAL ---------- */


/* ---------- AS PROJECT FILTER ACTIVE ONLY ---------- */
(function () {
  function normalize(text) {
    return String(text || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function initProjectActiveButtons() {
    var path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/projects') return;

    var buttons = Array.prototype.slice.call(document.querySelectorAll(
      '.projects-filters button, .projects-filters a, ' +
      '.project-filters button, .project-filters a, ' +
      '.projects-filter button, .projects-filter a, ' +
      '.filters button, .filters a, ' +
      '.filter-btn, .project-filter'
    ));

    if (!buttons.length) {
      buttons = Array.prototype.slice.call(document.querySelectorAll('button, a')).filter(function (el) {
        var text = normalize(el.textContent);
        return (
          text === 'все проекты' ||
          text === 'частные дома' ||
          text === 'квартиры' ||
          text === 'коммерческие' ||
          text === 'в процессе'
        );
      });
    }

    if (!buttons.length) return;

    function activateButton(activeButton) {
      buttons.forEach(function (button) {
        button.classList.remove('active', 'is-active', 'current');
        button.removeAttribute('data-active');
        button.setAttribute('aria-pressed', 'false');
      });

      activeButton.classList.add('active', 'is-active', 'current');
      activeButton.setAttribute('data-active', 'true');
      activeButton.setAttribute('aria-pressed', 'true');
    }

    buttons.forEach(function (button) {
      if (button.tagName.toLowerCase() === 'button') {
        button.setAttribute('type', 'button');
      }

      button.addEventListener('click', function (event) {
        var href = button.getAttribute('href');

        if (!href || href === '#' || href === window.location.pathname || href.indexOf('filter') !== -1) {
          event.preventDefault();
        }

        activateButton(button);
      });
    });

    var alreadyActive = buttons.find(function (button) {
      return button.classList.contains('active') || button.classList.contains('is-active') || button.hasAttribute('data-active');
    });

    activateButton(alreadyActive || buttons[0]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectActiveButtons, { once: true });
  } else {
    initProjectActiveButtons();
  }
})();
 /* ---------- END AS PROJECT FILTER ACTIVE ONLY ---------- */
