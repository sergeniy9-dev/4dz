/* ---------- AS GREETING COVER ---------- */
(function () {
  function runGreetingCover() {
    var cover = document.getElementById('asGreetingCover');
    if (!cover) return;

    document.documentElement.classList.add('as-greeting-lock');

    window.setTimeout(function () {
      cover.classList.add('is-leaving');
      document.documentElement.classList.remove('as-greeting-lock');

      window.setTimeout(function () {
        if (cover && cover.parentNode) {
          cover.parentNode.removeChild(cover);
        }
      }, 900);
    }, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runGreetingCover, { once: true });
  } else {
    runGreetingCover();
  }
})();
 /* ---------- END AS GREETING COVER ---------- */


/* ---------- AS PROJECT FILTERS FINAL ---------- */
(function () {
  function normalizeText(text) {
    return String(text || '')
      .toLowerCase()
      .replace(/\s+/g, ' ')
      .trim();
  }

  function getFilterFromText(text) {
    var value = normalizeText(text);

    if (value.includes('все')) return 'all';
    if (value.includes('дом')) return 'houses';
    if (value.includes('квартир')) return 'apartments';
    if (value.includes('коммер')) return 'commercial';
    if (value.includes('процесс')) return 'process';

    return 'all';
  }

  function getCardCategory(card) {
    if (card.dataset.projectCategory) return card.dataset.projectCategory;
    if (card.dataset.category) return card.dataset.category;
    if (card.dataset.filter) return card.dataset.filter;

    var text = normalizeText(card.textContent);

    if (
      text.includes('дом') ||
      text.includes('таунхаус') ||
      text.includes('коттедж') ||
      text.includes('загород')
    ) {
      return 'houses';
    }

    if (
      text.includes('квартир') ||
      text.includes('апартамент')
    ) {
      return 'apartments';
    }

    if (
      text.includes('офис') ||
      text.includes('коммер') ||
      text.includes('ресторан') ||
      text.includes('салон') ||
      text.includes('шоурум')
    ) {
      return 'commercial';
    }

    if (
      text.includes('в процессе') ||
      text.includes('строится') ||
      text.includes('реализации') ||
      text.includes('разработка')
    ) {
      return 'process';
    }

    return 'all';
  }

  function initProjectFilters() {
    var pageText = normalizeText(document.body.textContent);
    var isProjectsPage =
      window.location.pathname.replace(/\/+$/, '') === '/projects' ||
      pageText.includes('все проекты') ||
      pageText.includes('частные дома') ||
      pageText.includes('коммерческие');

    if (!isProjectsPage) return;

    var buttons = Array.from(document.querySelectorAll(
      '.projects-filter button, .projects-filters button, .project-filters button, .filters button, .filter-btn, [data-project-filter], [data-filter]'
    ));

    if (!buttons.length) {
      buttons = Array.from(document.querySelectorAll('button, a')).filter(function (el) {
        var text = normalizeText(el.textContent);
        return (
          text === 'все проекты' ||
          text === 'частные дома' ||
          text === 'квартиры' ||
          text === 'коммерческие' ||
          text === 'в процессе'
        );
      });
    }

    var cards = Array.from(document.querySelectorAll(
      '[data-project-card], .project-card, .projects-card, .projects-item, .project-item, .as-project-card'
    ));

    cards = cards.filter(function (card) {
      return !buttons.includes(card);
    });

    if (!buttons.length || !cards.length) return;

    buttons.forEach(function (button) {
      if (!button.dataset.projectFilter) {
        button.dataset.projectFilter = button.dataset.filter || getFilterFromText(button.textContent);
      }

      button.setAttribute('type', button.tagName.toLowerCase() === 'button' ? 'button' : button.getAttribute('type') || '');
    });

    cards.forEach(function (card) {
      if (!card.dataset.projectCategory) {
        card.dataset.projectCategory = getCardCategory(card);
      }
    });

    function setActiveButton(activeButton) {
      buttons.forEach(function (button) {
        button.classList.remove('active', 'is-active');
        button.setAttribute('aria-pressed', 'false');
      });

      activeButton.classList.add('active', 'is-active');
      activeButton.setAttribute('aria-pressed', 'true');
    }

    function filterProjects(filter) {
      cards.forEach(function (card) {
        var category = card.dataset.projectCategory || 'all';
        var show = filter === 'all' || category === filter;

        card.classList.toggle('project-card-hidden', !show);
        card.hidden = !show;
      });
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();

        var filter = button.dataset.projectFilter || getFilterFromText(button.textContent);

        setActiveButton(button);
        filterProjects(filter);

        if (window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('filter', filter);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    var params = new URLSearchParams(window.location.search);
    var startFilter = params.get('filter') || 'all';

    var startButton = buttons.find(function (button) {
      return button.dataset.projectFilter === startFilter;
    }) || buttons[0];

    setActiveButton(startButton);
    filterProjects(startButton.dataset.projectFilter || 'all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters, { once: true });
  } else {
    initProjectFilters();
  }
})();
 /* ---------- END AS PROJECT FILTERS FINAL ---------- */





/* ---------- AS PROJECT REAL FILTER FINAL ---------- */
(function () {
  function normalize(text) {
    return String(text || '')
      .toLowerCase()
      .replace(/ё/g, 'е')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function buttonFilter(button) {
    var text = normalize(button.textContent);

    if (text.includes('все')) return 'all';
    if (text.includes('дом')) return 'houses';
    if (text.includes('квартир')) return 'apartments';
    if (text.includes('коммер')) return 'commercial';
    if (text.includes('процесс')) return 'process';

    return button.dataset.projectFilter || button.dataset.filter || 'all';
  }

  function cardText(card) {
    var text = normalize(card.textContent);

    card.querySelectorAll('img').forEach(function (img) {
      text += ' ' + normalize(img.alt);
      text += ' ' + normalize(img.src);
    });

    return text;
  }

  function detectCategory(card, index) {
    if (card.dataset.projectCategory) return card.dataset.projectCategory;
    if (card.dataset.category) return card.dataset.category;
    if (card.dataset.filter) return card.dataset.filter;

    var text = cardText(card);

    if (
      text.includes('в процессе') ||
      text.includes('процесс') ||
      text.includes('реализац') ||
      text.includes('строит') ||
      text.includes('этап') ||
      text.includes('разработк')
    ) {
      return 'process';
    }

    if (
      text.includes('офис') ||
      text.includes('коммер') ||
      text.includes('шоурум') ||
      text.includes('ресторан') ||
      text.includes('салон') ||
      text.includes('обществен')
    ) {
      return 'commercial';
    }

    if (
      text.includes('квартир') ||
      text.includes('апартамент')
    ) {
      return 'apartments';
    }

    if (
      text.includes('дом') ||
      text.includes('коттедж') ||
      text.includes('таунхаус') ||
      text.includes('загород') ||
      text.includes('резиденц') ||
      text.includes('особняк')
    ) {
      return 'houses';
    }

    /*
      Если в карточке нет явных слов, распределяем по порядку:
      1 и 3 — дома
      2 и 4 — квартиры
      5 — коммерческий
      6 — в процессе
    */
    var fallback = ['houses', 'apartments', 'houses', 'apartments', 'commercial', 'process'];
    return fallback[index] || 'houses';
  }

  function findProjectButtons() {
    var exact = Array.prototype.slice.call(document.querySelectorAll(
      '.projects-filters button, .projects-filters a, ' +
      '.project-filters button, .project-filters a, ' +
      '.projects-filter button, .projects-filter a, ' +
      '.filters button, .filters a, ' +
      '.filter-btn, .project-filter'
    ));

    var byText = Array.prototype.slice.call(document.querySelectorAll('button, a')).filter(function (el) {
      var text = normalize(el.textContent);
      return (
        text === 'все проекты' ||
        text === 'частные дома' ||
        text === 'квартиры' ||
        text === 'коммерческие' ||
        text === 'в процессе'
      );
    });

    return Array.from(new Set(exact.concat(byText)));
  }

  function findProjectCards(buttons) {
    var candidates = Array.prototype.slice.call(document.querySelectorAll(
      '[data-project-card], ' +
      '.project-card, .projects-card, .projects-item, .project-item, ' +
      '.as-project-card, .portfolio-card, .portfolio-item, ' +
      '.projects-grid > *, .project-grid > *, .portfolio-grid > *'
    ));

    candidates = candidates.filter(function (card) {
      if (buttons.includes(card)) return false;
      if (card.closest('.projects-filters, .project-filters, .projects-filter, .filters')) return false;

      var text = normalize(card.textContent);
      var hasImage = !!card.querySelector('img');
      var hasHeading = !!card.querySelector('h2, h3, h4');

      return hasImage || hasHeading || text.length > 40;
    });

    /*
      Убираем лишние контейнеры: если внутри кандидата есть другие кандидаты,
      оставляем более внутренние карточки.
    */
    return candidates.filter(function (card) {
      return !candidates.some(function (other) {
        return other !== card && card.contains(other);
      });
    });
  }

  function initProjectRealFilter() {
    var path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/projects') return;

    var buttons = findProjectButtons();
    var cards = findProjectCards(buttons);

    if (!buttons.length || !cards.length) return;

    buttons.forEach(function (button) {
      if (button.tagName.toLowerCase() === 'button') {
        button.setAttribute('type', 'button');
      }

      button.dataset.projectFilter = buttonFilter(button);
    });

    cards.forEach(function (card, index) {
      card.dataset.projectCategory = detectCategory(card, index);
    });

    function activate(button) {
      buttons.forEach(function (item) {
        item.classList.remove('active', 'is-active', 'current');
        item.removeAttribute('data-active');
        item.setAttribute('aria-pressed', 'false');
      });

      button.classList.add('active', 'is-active', 'current');
      button.setAttribute('data-active', 'true');
      button.setAttribute('aria-pressed', 'true');
    }

    function applyFilter(filter) {
      cards.forEach(function (card) {
        var category = card.dataset.projectCategory || 'houses';
        var visible = filter === 'all' || category === filter;

        card.classList.toggle('as-project-hidden', !visible);
        card.hidden = !visible;
      });
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();

        var filter = button.dataset.projectFilter || 'all';

        activate(button);
        applyFilter(filter);

        if (window.history && window.history.replaceState) {
          var url = new URL(window.location.href);
          url.searchParams.set('filter', filter);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    var params = new URLSearchParams(window.location.search);
    var startFilter = params.get('filter') || 'all';

    var startButton = buttons.find(function (button) {
      return button.dataset.projectFilter === startFilter;
    }) || buttons[0];

    activate(startButton);
    applyFilter(startButton.dataset.projectFilter || 'all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectRealFilter, { once: true });
  } else {
    initProjectRealFilter();
  }
})();
 /* ---------- END AS PROJECT REAL FILTER FINAL ---------- */
