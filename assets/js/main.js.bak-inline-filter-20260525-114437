/* ---------- AS GREETING COVER ---------- */
(function () {
  function runGreetingCover() {
    var cover = document.getElementById('asGreetingCover');
    if (!cover) return;

    document.documentElement.classList.add('as-greeting-lock');

    window.setTimeout(function () {
      cover.classList.add('is-leaving');
      document.documentElement.classList.remove('as-greeting-lock');

      window.setTimeout(function () {
        if (cover && cover.parentNode) {
          cover.parentNode.removeChild(cover);
        }
      }, 900);
    }, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runGreetingCover, { once: true });
  } else {
    runGreetingCover();
  }
})();
 /* ---------- END AS GREETING COVER ---------- */











/* ---------- AS PROJECT BUTTONS SAFE FINAL ---------- */
(function () {
  function cleanText(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/ё/g, 'е')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function getFilterFromButton(button) {
    var text = cleanText(button.textContent);

    if (text === 'все проекты') return 'all';
    if (text === 'частные дома') return 'houses';
    if (text === 'квартиры') return 'apartments';
    if (text === 'коммерческие') return 'commercial';
    if (text === 'в процессе') return 'process';

    return 'all';
  }

  function initProjectButtons() {
    var path = window.location.pathname.replace(/\/+$/, '') || '/';
    if (path !== '/projects') return;

    var allowedTexts = [
      'все проекты',
      'частные дома',
      'квартиры',
      'коммерческие',
      'в процессе'
    ];

    var buttons = Array.prototype.slice.call(document.querySelectorAll('button, a')).filter(function (el) {
      return allowedTexts.indexOf(cleanText(el.textContent)) !== -1;
    });

    var cards = Array.prototype.slice.call(document.querySelectorAll('.project-card'));

    if (!buttons.length || !cards.length) return;

    /*
      Категории по порядку карточек на странице:
      1 — дом
      2 — квартира
      3 — дом
      4 — квартира
      5 — коммерческий
      6 — в процессе
    */
    var categories = ['houses', 'apartments', 'houses', 'apartments', 'commercial', 'process'];

    cards.forEach(function (card, index) {
      card.dataset.asProjectCategory = categories[index] || 'houses';
    });

    function setActive(activeButton) {
      buttons.forEach(function (button) {
        button.classList.remove('active', 'is-active', 'current');
        button.removeAttribute('data-active');
        button.setAttribute('aria-pressed', 'false');
      });

      activeButton.classList.add('active', 'is-active', 'current');
      activeButton.setAttribute('data-active', 'true');
      activeButton.setAttribute('aria-pressed', 'true');
    }

    function showCards(filter) {
      cards.forEach(function (card) {
        var category = card.dataset.asProjectCategory;
        var visible = filter === 'all' || category === filter;

        if (visible) {
          card.classList.remove('as-project-hidden');
          card.removeAttribute('hidden');
        } else {
          card.classList.add('as-project-hidden');
          card.setAttribute('hidden', 'hidden');
        }
      });
    }

    buttons.forEach(function (button) {
      if (button.tagName.toLowerCase() === 'button') {
        button.setAttribute('type', 'button');
      }

      button.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var filter = getFilterFromButton(button);

        setActive(button);
        showCards(filter);
      });
    });

    setActive(buttons[0]);
    showCards('all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectButtons, { once: true });
  } else {
    initProjectButtons();
  }
})();
 /* ---------- END AS PROJECT BUTTONS SAFE FINAL ---------- */
