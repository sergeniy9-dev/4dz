@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap");
:root {
  --bg: #efe9de !important;
  --bg-soft: #f8f3eb !important;
  --card: rgba(255,255,255,.64) !important;
  --card-strong: rgba(255,255,255,.86) !important;
  --text: #221f1a !important;
  --muted: #696053 !important;
  --muted-2: #968b7b !important;
  --line: rgba(72,58,38,.14) !important;
  --gold: #b99a5e !important;
  --gold-soft: #d7bf85 !important;
  --cream: #fff8ed !important;
  --shadow: 0 34px 90px rgba(77,62,38,.13) !important;
}

html,
body {
  background: #efe9de !important;
  color: #221f1a !important;
}

body {
  background:
    radial-gradient(circle at 12% 12%, rgba(255,255,255,.92), transparent 26rem),
    radial-gradient(circle at 82% 8%, rgba(185,154,94,.22), transparent 28rem),
    radial-gradient(circle at 70% 82%, rgba(92,75,49,.08), transparent 34rem),
    linear-gradient(135deg, #eee8dc, #f8f3eb 48%, #dfd3bf) !important;
}

body::before {
  background-image:
    linear-gradient(rgba(72,58,38,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(72,58,38,.035) 1px, transparent 1px) !important;
  background-size: 64px 64px !important;
  opacity: 1 !important;
  mask-image: linear-gradient(to bottom, rgba(0,0,0,.46), transparent 74%) !important;
}

body::after {
  content: "";
  position: fixed;
  inset: -12%;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(118deg, transparent 0 22%, rgba(100,88,71,.075) 22.2%, transparent 22.8% 46%, rgba(255,255,255,.52) 46.3%, transparent 47%),
    linear-gradient(146deg, transparent 0 39%, rgba(108,96,78,.065) 39.2%, transparent 40% 72%, rgba(151,126,78,.07) 72.2%, transparent 73%);
  filter: blur(1.2px);
  opacity: .7;
}

.site-header {
  background: rgba(248,243,235,.76) !important;
  backdrop-filter: blur(20px) !important;
  border-bottom: 1px solid rgba(72,58,38,.11) !important;
  box-shadow: 0 18px 60px rgba(77,62,38,.06) !important;
}

.header-inner {
  height: 96px !important;
}

.brand-mark {
  background:
    linear-gradient(145deg, rgba(255,255,255,.9), rgba(231,221,205,.58)) !important;
  border-color: rgba(185,154,94,.5) !important;
  box-shadow:
    inset 0 0 22px rgba(255,255,255,.72),
    0 12px 30px rgba(77,62,38,.10) !important;
}

.brand-mark span {
  border-color: #b99a5e !important;
}

.brand-text strong {
  color: #221f1a !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-weight: 400 !important;
  letter-spacing: .24em !important;
}

.brand-text small {
  color: #756b5d !important;
}

.nav a {
  color: #665d50 !important;
}

.nav a:hover,
.nav a.active {
  color: #221f1a !important;
  background: rgba(255,255,255,.72) !important;
  box-shadow: inset 0 0 0 1px rgba(185,154,94,.20) !important;
}

.header-phone {
  color: #5b4a2d !important;
  border-color: rgba(185,154,94,.42) !important;
  background: rgba(255,255,255,.52) !important;
}

.eyebrow {
  color: #84683b !important;
  letter-spacing: .26em !important;
}

h1,
h2 {
  color: #221f1a !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-weight: 400 !important;
  letter-spacing: -.055em !important;
}

h1 {
  font-size: clamp(48px, 6vw, 88px) !important;
  line-height: .98 !important;
}

h2 {
  font-size: clamp(36px, 4vw, 64px) !important;
  line-height: 1.02 !important;
}

h3 {
  color: #221f1a !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-weight: 400 !important;
}

.lead {
  color: #63594d !important;
}

.muted {
  color: #746b5d !important;
}

.btn {
  color: #221f1a !important;
  background: rgba(255,255,255,.56) !important;
  border-color: rgba(72,58,38,.16) !important;
  box-shadow: 0 16px 38px rgba(77,62,38,.08) !important;
}

.btn.primary {
  color: #221f1a !important;
  background: linear-gradient(135deg, #f1dcaa, #b99a5e) !important;
  border-color: transparent !important;
  box-shadow:
    0 22px 52px rgba(185,154,94,.28),
    inset 0 1px 0 rgba(255,255,255,.72) !important;
}

.hero {
  min-height: calc(100vh - 96px) !important;
  padding: 78px 0 78px !important;
}

.hero-grid {
  grid-template-columns: .9fr 1.1fr !important;
  gap: 64px !important;
}

.hero-card {
  min-height: 620px !important;
  border-radius: 46px !important;
  border-color: rgba(72,58,38,.13) !important;
  background:
    linear-gradient(145deg, rgba(255,255,255,.74), rgba(255,255,255,.28)),
    radial-gradient(circle at 72% 18%, rgba(185,154,94,.16), transparent 24rem),
    linear-gradient(135deg, #f5efe4, #ded2be) !important;
  box-shadow:
    0 44px 120px rgba(77,62,38,.16),
    inset 0 0 0 1px rgba(255,255,255,.62) !important;
}

.hero-card::before {
  width: 68% !important;
  height: 78% !important;
  left: 16% !important;
  bottom: 0 !important;
  border: 3px solid rgba(151,126,78,.48) !important;
  border-bottom: 0 !important;
  border-radius: 999px 999px 0 0 !important;
  box-shadow:
    inset 0 0 80px rgba(255,255,255,.48),
    0 0 58px rgba(151,126,78,.14) !important;
}

.hero-card::after {
  border-color: rgba(72,58,38,.08) !important;
}

.hero-badge {
  color: #6e5934 !important;
  border-color: rgba(185,154,94,.38) !important;
  background: rgba(255,255,255,.66) !important;
}

.hero-card-text strong {
  color: #221f1a !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-weight: 400 !important;
}

.stats {
  border-color: rgba(72,58,38,.12) !important;
  box-shadow: 0 24px 70px rgba(77,62,38,.08) !important;
}

.stat {
  background: rgba(255,255,255,.55) !important;
}

.stat strong {
  color: #84683b !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-weight: 400 !important;
}

.stat span {
  color: #6d6356 !important;
}

.band {
  border-block-color: rgba(72,58,38,.12) !important;
  background:
    linear-gradient(90deg, rgba(255,255,255,.28), rgba(255,255,255,.78), rgba(255,255,255,.28)) !important;
}

.marquee {
  color: #746b5d !important;
}

.marquee span {
  color: #84683b !important;
}

.card,
.step,
.form,
.presentation-card,
.signature-board,
.signature-point {
  background:
    linear-gradient(145deg, rgba(255,255,255,.74), rgba(255,255,255,.34)) !important;
  border-color: rgba(72,58,38,.13) !important;
  box-shadow:
    0 28px 80px rgba(77,62,38,.10),
    inset 0 0 0 1px rgba(255,255,255,.54) !important;
}

.card:hover {
  background: rgba(255,255,255,.86) !important;
  border-color: rgba(185,154,94,.36) !important;
  box-shadow:
    0 36px 94px rgba(77,62,38,.14),
    inset 0 0 0 1px rgba(255,255,255,.68) !important;
}

.card-num,
.step::before {
  color: #84683b !important;
}

.project {
  border-color: rgba(72,58,38,.13) !important;
  background:
    linear-gradient(145deg, rgba(255,255,255,.70), rgba(255,255,255,.28)),
    radial-gradient(circle at 70% 20%, rgba(185,154,94,.20), transparent 19rem),
    linear-gradient(135deg, #f5efe5, #ddd1bd) !important;
  box-shadow: 0 32px 90px rgba(77,62,38,.12) !important;
}

.project::before {
  border-color: rgba(151,126,78,.46) !important;
}

input,
textarea {
  color: #221f1a !important;
  background: rgba(255,255,255,.66) !important;
  border-color: rgba(72,58,38,.16) !important;
}

input::placeholder,
textarea::placeholder {
  color: #a19788 !important;
}

.footer {
  background:
    linear-gradient(180deg, rgba(255,255,255,.24), rgba(232,222,206,.74)) !important;
  border-top-color: rgba(72,58,38,.13) !important;
}

.footer h4 {
  color: #221f1a !important;
}

.footer-links a,
.footer-bottom {
  color: #746b5d !important;
}

.menu-btn {
  background: rgba(255,255,255,.66) !important;
  border-color: rgba(72,58,38,.15) !important;
}

.menu-btn span {
  background: #221f1a !important;
}

/* ---------- БЛОКИ КАК В ПРЕВЬЮ ---------- */

.signature-section {
  padding: 96px 0 !important;
  position: relative;
}

.signature-board {
  position: relative;
  overflow: hidden;
  border-radius: 42px !important;
  padding: clamp(30px, 5vw, 66px) !important;
  background:
    linear-gradient(145deg, rgba(255,255,255,.76), rgba(255,255,255,.34)),
    radial-gradient(circle at 14% 16%, rgba(255,255,255,.96), transparent 18rem),
    radial-gradient(circle at 86% 18%, rgba(185,154,94,.18), transparent 23rem),
    linear-gradient(135deg, #f4eee5, #ded2be) !important;
}

.signature-board::before {
  content: "";
  position: absolute;
  right: clamp(24px, 7vw, 90px);
  top: clamp(28px, 6vw, 74px);
  width: min(260px, 38vw);
  height: min(360px, 48vw);
  border: 2px solid rgba(151,126,78,.35);
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
  box-shadow:
    inset 0 0 44px rgba(255,255,255,.42),
    0 0 36px rgba(151,126,78,.11);
}

.signature-board::after {
  content: "";
  position: absolute;
  inset: 24px;
  border: 1px solid rgba(72,58,38,.08);
  border-radius: 30px;
  pointer-events: none;
}

.signature-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  gap: clamp(28px, 6vw, 76px);
  align-items: end;
}

.signature-points {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.signature-point {
  min-height: 170px;
  padding: 22px;
  border-radius: 26px !important;
}

.signature-point small {
  display: block;
  margin-bottom: 18px;
  color: #84683b;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-size: 11px;
}

.signature-point strong {
  display: block;
  color: #221f1a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px;
  font-weight: 400;
  line-height: 1.14;
  margin-bottom: 10px;
}

.signature-line {
  height: 1px;
  width: 100%;
  margin: 28px 0;
  background: linear-gradient(90deg, rgba(151,126,78,.58), transparent);
}

.material-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  overflow: hidden;
  border: 1px solid rgba(72,58,38,.13);
  border-radius: 30px;
  box-shadow: 0 28px 80px rgba(77,62,38,.09);
}

.material-cell {
  min-height: 190px;
  padding: 22px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.68), rgba(255,255,255,.28));
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.material-cell:nth-child(2) {
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.9), transparent 9rem),
    linear-gradient(135deg, #d7c7aa, #a98d55);
}

.material-cell:nth-child(3) {
  background:
    linear-gradient(118deg, transparent 0 32%, rgba(96,85,72,.11) 32.2%, transparent 33%),
    linear-gradient(135deg, #f5f0e8, #ded4c5);
}

.material-cell:nth-child(4) {
  background:
    radial-gradient(circle at 75% 15%, rgba(255,255,255,.28), transparent 9rem),
    linear-gradient(135deg, #2b261f, #706352);
  color: #f7f2e9;
}

.material-cell small {
  color: inherit;
  opacity: .62;
  text-transform: uppercase;
  letter-spacing: .18em;
  font-size: 10px;
}

.material-cell strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 25px;
  font-weight: 400;
}

.presentation-strip {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 20px;
  align-items: stretch;
}

.presentation-card {
  position: relative;
  overflow: hidden;
  min-height: 320px;
  border-radius: 34px !important;
  padding: 28px;
}

.presentation-card::before {
  content: "";
  position: absolute;
  right: 30px;
  bottom: 0;
  width: 150px;
  height: 230px;
  border: 1px solid rgba(151,126,78,.42);
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
}

.presentation-card.wide::before {
  width: 240px;
  height: 310px;
}

.presentation-card > * {
  position: relative;
  z-index: 2;
}

.mini-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 24px;
}

.mini-labels span {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 0 13px;
  border: 1px solid rgba(72,58,38,.13);
  border-radius: 999px;
  background: rgba(255,255,255,.54);
  color: #6d6356;
  font-size: 13px;
}

.quote-panel {
  border-left: 1px solid rgba(151,126,78,.52);
  padding-left: clamp(20px, 4vw, 42px);
}

.quote-panel p {
  color: #221f1a !important;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(26px, 4vw, 52px);
  line-height: 1.05;
  letter-spacing: -.045em;
}

.quote-panel span {
  color: #746b5d;
}

@media (max-width: 980px) {
  .nav {
    background: rgba(248,243,235,.98) !important;
  }

  .hero-grid,
  .signature-grid,
  .presentation-strip {
    grid-template-columns: 1fr !important;
  }

  .material-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 680px) {
  .header-inner {
    height: 82px !important;
  }

  .hero {
    padding: 46px 0 64px !important;
  }

  h1 {
    font-size: clamp(42px, 13vw, 62px) !important;
  }

  .signature-section {
    padding: 66px 0 !important;
  }

  .signature-board {
    border-radius: 30px !important;
  }

  .signature-points,
  .material-row {
    grid-template-columns: 1fr;
  }

  .material-cell {
    min-height: 150px;
  }
}


/* ---------- GRANITE GLASS SURFACES ---------- */

/* Общая логика:
   - база: теплый светлый камень / гранит / мрамор
   - сверху: стеклянный полированный слой
   - в глубине: мягкие прожилки и зерно
   - при hover: легкое оживление блика
*/

.card,
.signature-point,
.presentation-card,
.project,
.stat,
.step,
.form,
.material-cell,
.hero-card,
.signature-board {
  position: relative !important;
  overflow: hidden !important;
  isolation: isolate !important;
  backdrop-filter: blur(10px) saturate(110%) !important;
}

/* Контент всегда поверх эффектов */
.card > *,
.signature-point > *,
.presentation-card > *,
.project > *,
.stat > *,
.step > *,
.form > *,
.material-cell > *,
.hero-card > *,
.signature-board > * {
  position: relative;
  z-index: 3;
}

/* Каменная база */
.card,
.signature-point,
.presentation-card,
.project,
.stat,
.step,
.form {
  background:
    radial-gradient(circle at 18% 16%, rgba(255,255,255,.92), transparent 10rem),
    radial-gradient(circle at 82% 10%, rgba(185,154,94,.10), transparent 13rem),
    radial-gradient(circle at 74% 84%, rgba(120,106,84,.06), transparent 14rem),
    linear-gradient(135deg, #f7f2e9, #ede3d3 48%, #e3d7c4) !important;
}

/* Глубинная текстура / гранитные вкрапления */
.card::before,
.signature-point::before,
.presentation-card::before,
.project::after,
.stat::before,
.step::before,
.form::before,
.hero-card .stone-texture,
.signature-board .stone-texture {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  opacity: .60;
  background:
    radial-gradient(circle at 12% 18%, rgba(255,255,255,.38) 0 1px, transparent 1.8px),
    radial-gradient(circle at 36% 64%, rgba(134,118,95,.12) 0 1.2px, transparent 2px),
    radial-gradient(circle at 72% 24%, rgba(255,255,255,.32) 0 1px, transparent 1.7px),
    radial-gradient(circle at 82% 76%, rgba(128,112,89,.12) 0 1.1px, transparent 2px),
    radial-gradient(circle at 58% 48%, rgba(255,255,255,.26) 0 1px, transparent 1.8px),
    linear-gradient(118deg, transparent 0 26%, rgba(122,108,87,.08) 26.3%, transparent 27% 52%, rgba(255,255,255,.24) 52.4%, transparent 53%),
    linear-gradient(146deg, transparent 0 38%, rgba(118,102,80,.07) 38.3%, transparent 39% 73%, rgba(255,255,255,.18) 73.4%, transparent 74%);
  background-size:
    180px 180px,
    220px 220px,
    200px 200px,
    240px 240px,
    260px 260px,
    100% 100%,
    100% 100%;
  mix-blend-mode: multiply;
  filter: blur(.2px);
}

/* Верхний стеклянный полированный слой */
.card::after,
.signature-point::after,
.presentation-card::after,
.project::before,
.stat::after,
.step::after,
.form::after,
.material-cell::after,
.hero-card::after,
.signature-board::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(115deg,
      rgba(255,255,255,.58) 0%,
      rgba(255,255,255,.20) 18%,
      rgba(255,255,255,.04) 32%,
      rgba(255,255,255,.16) 52%,
      rgba(255,255,255,.04) 72%,
      rgba(255,255,255,.18) 100%);
  opacity: .50;
}

/* Диагональный блик как у полировки */
.card::after,
.signature-point::after,
.presentation-card::after,
.project::before,
.stat::after,
.step::after,
.form::after,
.material-cell::after {
  transform: translateX(-8%);
}

/* Дополнительная рамка как стеклянная фаска */
.card,
.signature-point,
.presentation-card,
.project,
.stat,
.step,
.form,
.material-cell,
.hero-card,
.signature-board {
  box-shadow:
    0 28px 80px rgba(77,62,38,.10),
    inset 0 0 0 1px rgba(255,255,255,.58),
    inset 0 1px 0 rgba(255,255,255,.75),
    inset 0 -10px 24px rgba(185,154,94,.04) !important;
}

/* Разные оттенки, чтобы плитки не были одинаковыми */
.cards .card:nth-child(3n+1),
.signature-points .signature-point:nth-child(3n+1),
.presentation-strip .presentation-card:nth-child(3n+1),
.project-grid .project:nth-child(3n+1) {
  background:
    radial-gradient(circle at 14% 16%, rgba(255,255,255,.95), transparent 10rem),
    radial-gradient(circle at 84% 10%, rgba(185,154,94,.11), transparent 13rem),
    linear-gradient(135deg, #f8f4ec, #ede4d6 50%, #e4d8c8) !important;
}

.cards .card:nth-child(3n+2),
.signature-points .signature-point:nth-child(3n+2),
.presentation-strip .presentation-card:nth-child(3n+2),
.project-grid .project:nth-child(3n+2) {
  background:
    radial-gradient(circle at 12% 12%, rgba(255,255,255,.92), transparent 10rem),
    radial-gradient(circle at 80% 12%, rgba(194,171,129,.13), transparent 12rem),
    linear-gradient(135deg, #f2ece3, #e7dccb 52%, #ddd0bd) !important;
}

.cards .card:nth-child(3n),
.signature-points .signature-point:nth-child(3n),
.presentation-strip .presentation-card:nth-child(3n),
.project-grid .project:nth-child(3n) {
  background:
    radial-gradient(circle at 18% 18%, rgba(255,255,255,.95), transparent 10rem),
    radial-gradient(circle at 76% 14%, rgba(174,149,104,.10), transparent 12rem),
    linear-gradient(135deg, #f7f1e8, #ece1d1 48%, #e2d5c2) !important;
}

/* Material cells делаем еще эффектнее */
.material-cell {
  position: relative !important;
  overflow: hidden !important;
  isolation: isolate !important;
  box-shadow:
    0 24px 60px rgba(77,62,38,.09),
    inset 0 0 0 1px rgba(255,255,255,.54),
    inset 0 1px 0 rgba(255,255,255,.72) !important;
}

.material-cell::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(circle at 24% 20%, rgba(255,255,255,.46), transparent 8rem),
    linear-gradient(126deg, transparent 0 28%, rgba(118,100,76,.10) 28.4%, transparent 29% 64%, rgba(255,255,255,.18) 64.3%, transparent 65%),
    radial-gradient(circle at 74% 76%, rgba(120,106,84,.10) 0 1px, transparent 2px);
  mix-blend-mode: multiply;
}

.material-cell > * {
  position: relative;
  z-index: 3;
}

/* На hover плитки слегка "оживают" */
.card:hover,
.signature-point:hover,
.presentation-card:hover,
.project:hover,
.stat:hover,
.step:hover,
.material-cell:hover {
  transform: translateY(-4px) !important;
  box-shadow:
    0 38px 96px rgba(77,62,38,.15),
    inset 0 0 0 1px rgba(255,255,255,.68),
    inset 0 1px 0 rgba(255,255,255,.82),
    inset 0 -12px 26px rgba(185,154,94,.06) !important;
}

/* Блик движется чуть-чуть при наведении */
.card:hover::after,
.signature-point:hover::after,
.presentation-card:hover::after,
.project:hover::before,
.stat:hover::after,
.step:hover::after,
.form:hover::after,
.material-cell:hover::after {
  opacity: .72;
  transform: translateX(4%);
  transition: transform .45s ease, opacity .45s ease;
}

/* HERO делаем особенно гладким и polished */
.hero-card {
  background:
    radial-gradient(circle at 16% 14%, rgba(255,255,255,.92), transparent 11rem),
    radial-gradient(circle at 84% 12%, rgba(185,154,94,.12), transparent 13rem),
    linear-gradient(135deg, #f8f3eb, #ede3d4 46%, #e1d5c3) !important;
}

.hero-card::before {
  z-index: 2 !important;
}

.hero-card::after {
  z-index: 1 !important;
  opacity: .42 !important;
}

/* Signature board делаем как "дорогую плиту" */
.signature-board {
  background:
    radial-gradient(circle at 14% 14%, rgba(255,255,255,.96), transparent 14rem),
    radial-gradient(circle at 86% 18%, rgba(185,154,94,.14), transparent 18rem),
    linear-gradient(135deg, #f7f2ea, #ece2d2 50%, #e1d6c3) !important;
}

/* Убираем конфликт с уже существующими арками в карточках */
.project::after {
  inset: 0;
}

.presentation-card::before,
.project::before {
  pointer-events: none;
}

/* Адаптив */
@media (max-width: 680px) {
  .card::after,
  .signature-point::after,
  .presentation-card::after,
  .project::before,
  .stat::after,
  .step::after,
  .form::after,
  .material-cell::after {
    opacity: .42;
  }
}


/* ---------- SHOWROOM LUXURY LAYER ---------- */

:root {
  --lux-dark: #211d17;
  --lux-dark-2: #3b3329;
  --lux-brass: #b99a5e;
  --lux-brass-soft: #e0c78e;
  --lux-stone: #f6f0e6;
  --lux-stone-2: #e5d8c4;
}

/* Общая премиальная фаска */
.card,
.signature-point,
.presentation-card,
.project,
.stat,
.step,
.form,
.material-cell,
.hero-card,
.signature-board {
  border: 1px solid rgba(104, 82, 48, .18) !important;
  outline: 1px solid rgba(255,255,255,.52) !important;
  outline-offset: -2px !important;
  transform-style: preserve-3d;
  transition:
    transform .38s cubic-bezier(.19,1,.22,1),
    box-shadow .38s cubic-bezier(.19,1,.22,1),
    border-color .38s cubic-bezier(.19,1,.22,1),
    filter .38s cubic-bezier(.19,1,.22,1) !important;
}

/* Полированная поверхность с живым пятном света */
.card::after,
.signature-point::after,
.presentation-card::after,
.project::after,
.stat::after,
.material-cell::after,
.hero-card::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: 2 !important;
  pointer-events: none !important;
  border-radius: inherit !important;
  background:
    radial-gradient(
      circle at var(--mx, 52%) var(--my, 18%),
      rgba(255,255,255,.72),
      rgba(255,255,255,.18) 18%,
      rgba(255,255,255,0) 42%
    ),
    linear-gradient(
      118deg,
      rgba(255,255,255,.62) 0%,
      rgba(255,255,255,.12) 16%,
      rgba(255,255,255,.02) 32%,
      rgba(255,255,255,.18) 54%,
      rgba(255,255,255,.04) 78%,
      rgba(255,255,255,.24) 100%
    ) !important;
  opacity: .56 !important;
  mix-blend-mode: screen;
  transform: translate3d(0,0,1px);
  transition:
    opacity .38s ease,
    background-position .38s ease,
    transform .38s ease !important;
}

/* Каменная глубина */
.card::before,
.signature-point::before,
.stat::before,
.material-cell::before {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: 1 !important;
  pointer-events: none !important;
  border-radius: inherit !important;
  opacity: .72 !important;
  background:
    radial-gradient(circle at 12% 20%, rgba(255,255,255,.42) 0 1px, transparent 2px),
    radial-gradient(circle at 38% 62%, rgba(93,78,58,.11) 0 1px, transparent 2px),
    radial-gradient(circle at 74% 28%, rgba(255,255,255,.30) 0 1px, transparent 2px),
    radial-gradient(circle at 88% 78%, rgba(98,81,58,.10) 0 1px, transparent 2px),
    linear-gradient(123deg, transparent 0 28%, rgba(104,86,62,.08) 28.3%, transparent 29% 64%, rgba(255,255,255,.28) 64.3%, transparent 65%),
    linear-gradient(148deg, transparent 0 40%, rgba(95,78,55,.07) 40.3%, transparent 41% 72%, rgba(255,255,255,.18) 72.4%, transparent 73%) !important;
  background-size:
    170px 170px,
    230px 230px,
    190px 190px,
    260px 260px,
    100% 100%,
    100% 100% !important;
  mix-blend-mode: multiply;
}

/* Контент поверх стекла */
.card > *,
.signature-point > *,
.presentation-card > *,
.project > *,
.stat > *,
.step > *,
.form > *,
.material-cell > *,
.hero-card > *,
.signature-board > * {
  position: relative;
  z-index: 5;
}

/* Hover: эффект дорогой полировки, не кислотный */
.card:hover,
.signature-point:hover,
.presentation-card:hover,
.project:hover,
.stat:hover,
.step:hover,
.material-cell:hover {
  transform: translateY(-6px) !important;
  border-color: rgba(185,154,94,.36) !important;
  box-shadow:
    0 42px 110px rgba(77,62,38,.18),
    inset 0 0 0 1px rgba(255,255,255,.74),
    inset 0 1px 0 rgba(255,255,255,.88),
    inset 0 -18px 36px rgba(185,154,94,.07) !important;
}

.card:hover::after,
.signature-point:hover::after,
.presentation-card:hover::after,
.project:hover::after,
.stat:hover::after,
.material-cell:hover::after,
.hero-card:hover::after {
  opacity: .82 !important;
}

/* Латунная кромка сверху */
.card,
.signature-point,
.presentation-card,
.project,
.stat,
.step,
.form {
  box-shadow:
    0 30px 88px rgba(77,62,38,.11),
    inset 0 0 0 1px rgba(255,255,255,.62),
    inset 0 1px 0 rgba(255,255,255,.82),
    inset 0 4px 0 rgba(185,154,94,.10) !important;
}

/* Кнопки как стекло с латунным бликом */
.btn {
  position: relative !important;
  overflow: hidden !important;
  isolation: isolate !important;
  backdrop-filter: blur(14px) saturate(118%) !important;
  border: 1px solid rgba(104,82,48,.18) !important;
  box-shadow:
    0 18px 46px rgba(77,62,38,.10),
    inset 0 0 0 1px rgba(255,255,255,.46),
    inset 0 1px 0 rgba(255,255,255,.80) !important;
}

.btn::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 18% 10%, rgba(255,255,255,.82), transparent 8rem),
    linear-gradient(120deg, rgba(255,255,255,.60), rgba(255,255,255,.12) 42%, rgba(255,255,255,.34)) !important;
  opacity: .76;
  transition: transform .45s ease, opacity .45s ease;
}

.btn::after {
  content: "";
  position: absolute;
  left: -40%;
  top: 0;
  width: 40%;
  height: 100%;
  z-index: -1;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
  transform: skewX(-18deg);
  opacity: 0;
}

.btn:hover::after {
  animation: buttonSheen .9s ease;
}

@keyframes buttonSheen {
  0% { left: -45%; opacity: 0; }
  20% { opacity: .75; }
  100% { left: 120%; opacity: 0; }
}

.btn.primary {
  background:
    radial-gradient(circle at 24% 10%, rgba(255,255,255,.72), transparent 9rem),
    linear-gradient(135deg, #f3dfad, #b99a5e 56%, #957640) !important;
}

/* Hero: живой showroom-свет */
.hero-card {
  background:
    radial-gradient(circle at var(--mx, 72%) var(--my, 18%), rgba(255,255,255,.85), transparent 18rem),
    radial-gradient(circle at 18% 14%, rgba(255,255,255,.92), transparent 13rem),
    radial-gradient(circle at 86% 18%, rgba(185,154,94,.16), transparent 16rem),
    linear-gradient(135deg, #f8f3eb, #eadfce 48%, #ded1bd) !important;
  animation: showroomHeroLight 7s ease-in-out infinite alternate;
}

@keyframes showroomHeroLight {
  from {
    box-shadow:
      0 44px 120px rgba(77,62,38,.16),
      inset 0 0 0 1px rgba(255,255,255,.68),
      inset 0 1px 0 rgba(255,255,255,.86),
      inset 0 -22px 44px rgba(185,154,94,.06) !important;
  }
  to {
    box-shadow:
      0 54px 140px rgba(77,62,38,.20),
      inset 0 0 0 1px rgba(255,255,255,.78),
      inset 0 1px 0 rgba(255,255,255,.92),
      inset 0 -28px 54px rgba(185,154,94,.09) !important;
  }
}

/* Восстанавливаем арку в hero поверх стекла */
.hero-card::before {
  z-index: 3 !important;
  opacity: .9 !important;
}

/* Темные акцентные showroom-плитки */
.presentation-card.wide,
.project-grid .project:nth-child(4),
.material-cell:nth-child(4) {
  color: #f6efe4 !important;
  background:
    radial-gradient(circle at var(--mx, 72%) var(--my, 18%), rgba(255,255,255,.16), transparent 16rem),
    radial-gradient(circle at 80% 12%, rgba(224,199,142,.18), transparent 15rem),
    linear-gradient(135deg, #201c17, #3b3329 48%, #6f604b) !important;
  border-color: rgba(224,199,142,.34) !important;
  outline-color: rgba(255,255,255,.12) !important;
  box-shadow:
    0 42px 120px rgba(37,29,20,.25),
    inset 0 0 0 1px rgba(255,255,255,.12),
    inset 0 1px 0 rgba(255,255,255,.18),
    inset 0 4px 0 rgba(224,199,142,.16) !important;
}

.presentation-card.wide h3,
.presentation-card.wide p,
.presentation-card.wide .muted,
.presentation-card.wide .eyebrow,
.project-grid .project:nth-child(4) h3,
.project-grid .project:nth-child(4) p,
.project-grid .project:nth-child(4) .muted,
.material-cell:nth-child(4) small,
.material-cell:nth-child(4) strong {
  color: #f6efe4 !important;
}

.presentation-card.wide .mini-labels span {
  color: #f6efe4 !important;
  border-color: rgba(224,199,142,.28) !important;
  background: rgba(255,255,255,.08) !important;
}

/* Латунная арка на темных карточках */
.presentation-card.wide::before,
.project-grid .project:nth-child(4)::before {
  content: "";
  position: absolute;
  right: 28px;
  bottom: 0;
  width: 220px;
  height: 300px;
  z-index: 1;
  border: 1px solid rgba(224,199,142,.36);
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
  background: none !important;
  box-shadow:
    inset 0 0 42px rgba(224,199,142,.05),
    0 0 44px rgba(224,199,142,.08);
}

/* Обычные presentation/project арки возвращаем */
.presentation-card:not(.wide)::before {
  content: "";
  position: absolute;
  right: 30px;
  bottom: 0;
  width: 150px;
  height: 230px;
  z-index: 1;
  border: 1px solid rgba(151,126,78,.42);
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
  background: none !important;
}

.project-grid .project:not(:nth-child(4))::before {
  content: "";
  position: absolute;
  inset: 28px 34px auto auto;
  width: 120px;
  height: 180px;
  z-index: 1;
  border: 1px solid rgba(151,126,78,.46);
  border-bottom: 0;
  border-radius: 70px 70px 0 0;
  background: none !important;
}

/* Исправляем номера этапов, если гранитный слой их перебил */
.steps {
  counter-reset: step;
}

.step {
  position: relative !important;
}

.step::before {
  content: "0" counter(step) !important;
  position: relative !important;
  inset: auto !important;
  z-index: 5 !important;
  display: block !important;
  width: auto !important;
  height: auto !important;
  color: #84683b !important;
  background: none !important;
  opacity: 1 !important;
  font-family: Georgia, "Times New Roman", serif !important;
  font-size: 24px !important;
  letter-spacing: .12em !important;
  filter: none !important;
  mix-blend-mode: normal !important;
}

/* Больше ощущения дорогого каталога */
.card-num,
.signature-point small,
.material-cell small,
.eyebrow {
  font-weight: 600 !important;
}

.card h3,
.presentation-card h3,
.project h3,
.signature-point strong {
  letter-spacing: -.025em !important;
}

/* Тонкая линия под заголовками больших секций */
.section > .container > h2,
.signature-board h2 {
  position: relative;
}

.section > .container > h2::after,
.signature-board h2::after {
  content: "";
  display: block;
  width: min(220px, 45vw);
  height: 1px;
  margin-top: 22px;
  background: linear-gradient(90deg, rgba(185,154,94,.72), transparent);
}

/* Приятнее формы */
input,
textarea {
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.48),
    0 10px 26px rgba(77,62,38,.05) !important;
}

input:focus,
textarea:focus {
  background: rgba(255,255,255,.82) !important;
  border-color: rgba(185,154,94,.70) !important;
  box-shadow:
    0 0 0 4px rgba(185,154,94,.13),
    inset 0 0 0 1px rgba(255,255,255,.76) !important;
}

/* Мобильная версия без перегруза */
@media (max-width: 680px) {
  .presentation-card.wide,
  .project-grid .project:nth-child(4),
  .material-cell:nth-child(4) {
    box-shadow:
      0 30px 82px rgba(37,29,20,.18),
      inset 0 0 0 1px rgba(255,255,255,.12) !important;
  }

  .card:hover,
  .signature-point:hover,
  .presentation-card:hover,
  .project:hover,
  .stat:hover,
  .step:hover,
  .material-cell:hover {
    transform: none !important;
  }
}

